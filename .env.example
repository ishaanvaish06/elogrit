# Database Configuration
# Use SQLite for simple local development or PostgreSQL for production:
# DATABASE_URL=sqlite+aiosqlite:///./leetcode.db
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/leetcode_db
DATABASE_URL=sqlite+aiosqlite:///./leetcode.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Scheduler Configuration
ENABLE_SCHEDULER=true
